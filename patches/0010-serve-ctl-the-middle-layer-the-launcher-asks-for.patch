 """
 from __future__ import annotations
 
+import json
 import os
 import pathlib
 import re
@@ -178,6 +179,315 @@ def model_expert_bytes(pack: pathlib.Path | None, gguf: pathlib.Path) -> int | N
         return None
 
 
+# Bytes of KV per cell per layer, by --kv (the engine's own layouts).
+KV_BYTES_PER_CELL = {"fp16": 2048, "int8": 1056, "k8v4": 816, "q4_0": 528}
+
+
+def model_shapes(gguf: pathlib.Path) -> dict | None:
+    """n_layers, dense bytes (weights that live in VRAM) and the expert bytes, from the header alone."""
+    tools = pathlib.Path(__file__).resolve().parent.parent / "tools"
+    if tools.is_dir() and str(tools) not in sys.path:
+        sys.path.insert(0, str(tools))
+    try:
+        import gguf_reader as G
+        g = G.GGUFFile(gguf)
+        arch = g.metadata.get("general.architecture") or ""
+        blocks = g.metadata.get(arch + ".block_count")
+        nextn = g.metadata.get(arch + ".nextn_predict_layers") or 0
+        if not blocks:
+            return None
+        n_layers = int(blocks) - int(nextn)                 # the MTP block is not a main layer
+        dense = experts = 0
+        for t in g.tensors:
+            nb = t.expected_bytes() or 0
+            if t.name.endswith("_exps.weight"):
+                experts += nb
+            elif t.name == "per_layer_token_embd.weight":   # the PLE table is read from its own GGUF
+                continue
+            else:
+                dense += nb
+        ctx_train = g.metadata.get(arch + ".context_length") or 0
+        return {"layers": n_layers, "dense": dense, "experts": experts,
+                "ctx_train": int(ctx_train)}
+    except Exception:
+        return None
+
+
+# 建议 ctx 的模型（全部来自实测，见 ensure_fit）：
+#   * 每 token 的 K/V 在显存里约占 KV_MIB_PER_TOKEN（全量 32.6 KiB 的 ~35%，其余从主机内存流式）
+#   * 一个专家槽 = 专家总字节 / (层数 × 每层专家数)；量化越大，槽越大 —— 所以按「保留多少比例的专家」
+#     来分显存，天然适配不同量化
+CTX_PER_MIB = 77               # 显存每 MiB（扣掉权重与 MTP 头）约换多少 token 的上下文：
+                               #   短模式 1376 MiB -> 106496（77.4）；长模式 1688 -> 139264（82.5）；
+                               #   MTP off 1815 -> 160768（88.6）。取最小，保证不超实测。
+SUGGEST_MAX_FRACTION = 0.8     # 建议值不超过上限的 80%（KV 分配是离散的，留余量）
+KV_MIB_PER_TOKEN = 0.032      # 每 token 的 K/V 在显存里占多少 MiB。实测：Cyber IQ4_XS 上 31.4/36.1/29.2 KiB
+                               # （≈ 完整 KV = 816 B × 40 层 = 32.6 KiB，KV 并没有流式）；IQ3_S 上约 12 KiB（部分流式）。
+                               # 取最坏情况 0.032，宁可建议值保守，也不承诺保不住的槽位。
+CACHE_KEEP_FRACTION = 0.45     # 扣掉固定开销后，显存预算里留给专家缓存的比例（实测反推：IQ3_S 短模式
+                               # 20k ctx -> 969 槽 / 65k -> 590 槽；Cyber IQ4_XS 53k -> 258 槽，都落在这条线上）
+VRAM_FIXED_MIB = 400           # verify 窗口(178) + prompt 缓冲 + token graph 等固定占用（实测反推 380-430）
+CACHE_KEEP_FLOOR = 400         # 但至少留这么多槽（引擎自己要求 >=287 才能跑 verify）
+
+
+def gpu_free_mib() -> int | None:
+    try:
+        out = subprocess.run(["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"],
+                             capture_output=True, text=True, timeout=10)
+        return int(out.stdout.strip().splitlines()[0])
+    except Exception:
+        return None
+
+
+def ensure_fit(cfg: dict, log=print) -> bool:
+    """Say how much context this model+kv can actually hold, and clamp --pool-workers to the cores.
+
+    --max-context is a requirement, so it is only *reported*, never changed -- the engine refuses
+    with the exact shortfall anyway.  --pool-workers copied from another machine is clamped.
+    """
+    if os.environ.get("STRATA_NO_BUDGET") == "1":
+        return False
+    args = list(cfg.get("args") or [])
+    native = _arg(args, "--native")
+    if not native:
+        return False
+    gguf = pathlib.Path(native)
+    if not gguf.is_file():
+        return False
+    changed = False
+
+    # ---- pool workers: never more than the physical cores
+    try:
+        import psutil
+        phys = psutil.cpu_count(logical=False) or 0
+    except Exception:
+        phys = 0
+    if phys and "--pool-workers" in args:
+        try:
+            cur = int(args[args.index("--pool-workers") + 1])
+        except ValueError:
+            cur = 0
+        if cur > phys:
+            want = max(1, phys - 2)
+            args[args.index("--pool-workers") + 1] = str(want)
+            changed = True
+            log(f"[prepare] --pool-workers {cur} -> {want} (this machine has {phys} physical cores)")
+
+    # ---- how much context fits: free VRAM - weights - MTP - reserve, divided by the KV per cell
+    shapes = model_shapes(gguf)
+    free = gpu_free_mib()
+    if free is not None and free < 512:
+        # 还剩不到 512 MiB：多半已经有一个引擎占着显存。此时算出来的上限/建议没有意义，
+        # 写了反而会把界面数字带偏（曾写出 ctx_suggested=0）。跳过，保留上一次的值。
+        log(f"[prepare] fit: only {free} MiB of VRAM free - is another engine already running? "
+            f"skipping the ceiling/suggestion for this start (the previous capacity file is kept)")
+        return changed
+    kv = _arg(args, "--kv") or "k8v4"
+    bpc = KV_BYTES_PER_CELL.get(kv)
+    if shapes and free and bpc:
+        reserve = int(_arg(args, "--vram-reserve-mib") or 64)
+        mtp_bind = 127 if _arg(args, "--mtp-cpu-moe") in ("1", "on") else 439
+        budget_mib = free - reserve - shapes["dense"] / 2**20 - (mtp_bind if "--mtp" in args else 0)
+        # 实测标定（2026-11-24，IQ3_S / k8v4 / 4 GB 卡）：显存每 MiB（扣掉权重与 MTP 头）约换 77-89 token 上下文，
+        # 取决于 KV 流式窗口的取整；取最保守的 77，保证估算不超实测：
+        #   短模式(MTP 在显存) 1376 MiB -> 106496（77.4）；长模式(MTP 在 CPU) 1688 -> 139264（82.5）；
+        #   MTP off 1815 MiB -> 160768（88.6，这是上限，对应把 MTP 的显存省下来）
+        ctx_max = int(max(0, budget_mib) * CTX_PER_MIB / 1024) * 1024
+        want = int(_arg(args, "--max-context") or 0)
+        log(f"[prepare] fit: weights {shapes['dense'] / 2**20:.0f} MiB, free VRAM {free} MiB, "
+            f"{kv} {bpc} B/cell x {shapes['layers']} layers -> up to about {ctx_max} ctx "
+            f"(calibrated: {CTX_PER_MIB} ctx per MiB of VRAM left after the weights and the MTP head; "
+            f"that is where the MTP verify tier runs out of VRAM and the engine refuses to start)")
+        # KV 流式要显式打开：--kv-resident N（N >= 20480）才把 K/V 放固定内存、显存只留 N 个 cell 的
+        # 注意力窗口；**0（默认）= 全部 KV 驻显存**（引擎 help 原文；实测 IQ3_S @20480 只剩 657 槽也印证）。
+        # 原来这里写成 `not resident`，把默认当成了流式 —— 日志和守卫因此都是反的。
+        ctx_ram = 0
+        resident = int(_arg(args, "--kv-resident") or 0)
+        if bpc and resident >= 20480:
+            try:
+                import psutil
+                avail = psutil.virtual_memory().available
+            except Exception:
+                avail = 0
+            pack = _arg(args, "--pack")
+            exp = model_expert_bytes(pathlib.Path(pack) if pack and "%" not in pack else None, gguf) or 0
+            room_mib = (avail - exp) / 2**20 - 500
+            if room_mib > 0:
+                ctx_ram = int(room_mib * 2**20 / (bpc * max(1, shapes["layers"])) // 1024 * 1024)
+                if shapes.get("ctx_train"):
+                    ctx_ram = min(ctx_ram, shapes["ctx_train"])
+                log(f"[prepare] fit: KV streams from RAM (--kv-resident {resident}): RAM available {avail / 2**20:.0f} MiB, "
+                    f"experts {exp / 2**20:.0f} MiB, guard 500 MiB -> up to {ctx_ram} ctx "
+                    f"(trained for {shapes.get('ctx_train') or '?'})")
+        if want > (ctx_ram or ctx_max):
+            log(f"[prepare] note --max-context {want} is past the {ctx_max} that fits all at once; "
+                f"that is fine while the conversation stays below {ctx_max} tokens (the KV grows "
+                f"lazily). If you really fill it: lower --max-context, smaller quant, or --kv q4_0 "
+                f"(528 B/cell)")
+        # ---- 建议 ctx：先保留 x% 专家槽，剩下的给 KV。
+        # KV/token 优先用**上一轮实测标定**的值（启动器从引擎日志反推后写进同一份 capacity），
+        # 没有实测过就用保守回退值 0.032（这个模型上 KV 几乎全驻显存）。
+        kvpt = KV_MIB_PER_TOKEN
+        ctx_suggested = 0
+        cache_keep_mib = 0.0
+        slot_mib = 0.0
+        if bpc and ctx_max > 0:
+            n_experts = 256                              # 每层专家数；读不到就用 256（35B-A3B 就是 256）
+            try:
+                tools2 = pathlib.Path(__file__).resolve().parent.parent / "tools"
+                if tools2.is_dir() and str(tools2) not in sys.path:
+                    sys.path.insert(0, str(tools2))
+                import gguf_reader as G2
+                meta = G2.GGUFFile(gguf).metadata
+                arch2 = meta.get("general.architecture") or ""
+                n_experts = int(meta.get(arch2 + ".expert_count") or 256)
+            except Exception:
+                pass
+            total_slots = max(1, shapes["layers"] * n_experts)
+            slot_mib = (shapes["experts"] / 2**20) / total_slots
+            room = max(0.0, budget_mib - VRAM_FIXED_MIB)
+            slug_pre = re.sub(r"[^A-Za-z0-9._-]+", "_", gguf.name) + "-" + re.sub(r"[^A-Za-z0-9._-]+", "_", kv)
+            slug_pre += ("-mtpcpu" if _arg(args, "--mtp-cpu-moe") in ("1", "on")
+                         else ("-nomtp" if "--mtp" not in args else "-mtpgpu"))
+            try:                                   # 上一轮实测的 KV/token（启动器写的）优先
+                _prev = json.loads((pathlib.Path(__file__).resolve().parent.parent.parent / "results" / "capacity" / (slug_pre + ".json")).read_text(encoding="utf-8"))
+                _meas = float(_prev.get("kv_measured_mib_per_token") or 0)
+                if _meas > 0:
+                    kvpt = max(kvpt, _meas)
+                    log(f"[prepare] using the last run's measured K/V cost {kvpt * 1024:.1f} KiB/token ({slug_pre})")
