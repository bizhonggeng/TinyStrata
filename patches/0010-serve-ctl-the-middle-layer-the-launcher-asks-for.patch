+class TestEnv(unittest.TestCase):
+    def setUp(self):
+        import os
+        self._path = os.environ.get("PATH", "")
+        os.environ["PATH"] = ""          # 隔离：本机 PATH 里确实有 CUDA DLL
+
+    def tearDown(self):
+        import os
+        os.environ["PATH"] = self._path
+
+    def test_missing_dlls(self):
+        from strata.ctl import env as E
+        got = E.check_env(lib_dirs=[], cap="8.6")
+        self.assertEqual([g["code"] for g in got], ["env.cudart.missing", "env.cublas.missing"])
+        self.assertFalse(any(g["hard"] for g in got))
+
+    def test_dlls_found(self):
+        import tempfile, pathlib
+        from strata.ctl import env as E
+        d = pathlib.Path(tempfile.mkdtemp())
+        for name in E.CUDA_DLLS:
+            (d / name).write_bytes(b"")
+        self.assertEqual(E.check_env(lib_dirs=[str(d)], cap="8.6"), [])
+
+    def test_sm_mismatch_soft(self):
+        from strata.ctl import env as E
+        got = E.check_env(lib_dirs=[], cap="8.9")
