new file mode 100644
index 00000000..cf799056
--- /dev/null
+++ b/ctl/__main__.py
@@ -0,0 +1,263 @@
+"""`python -m strata.ctl` —— 给界面（AHK）/脚本用的适配器。
+
+两个子命令：
+
+    python -m strata.ctl plan    --ini-in in.ini --ini-out state.ini [--json state.json]
+                                 [--results DIR] [--native PATH] [--lang zh|en]
+    python -m strata.ctl observe --ini-out state.ini [--engine-log F] [--server-log F] [--run-config F]
+
+`plan` 的输出（state.ini）：
+
+    [meta]      schema_version / seq
+    [params]    原样带回（界面据此回显）
+    [resolved]  mtp / mtp_cpu_moe / spec / kv / kv_resident / slug     ← 唯一真相源
+    [flags]     MTP 三段的命令行片段
+    [bounds]    边界与建议值（来自 capacity；没有数据就 measured=false）
+    [warn.N]    预检提醒（code / hard / p_*）
+    [errors.N]  读入失败等（界面永远有东西可渲染）
+
+退出码：0 正常；2 入参文件不可读。
+"""
+
+from __future__ import annotations
+
+import argparse
+import configparser
+import json
+import sys
+import time
+from pathlib import Path
+
+from . import fit as F
+from . import observe as O
+from . import params as P
+from . import env as E
+from . import preflight as PF
+
+SCHEMA_VERSION = 1
+FACT_KEYS = ("engine_pid", "serve_pid", "guard_pid", "budget_mib", "ceiling", "suggested",
+             "ram_free_mb", "ram_total_mb", "model_path", "pack_problem", "slot_mib", "kvpt")
+
+
+def _read_ini(path: Path) -> tuple[dict, configparser.ConfigParser]:
+    cp = configparser.ConfigParser(interpolation=None)
+    cp.read(path, encoding="utf-8-sig")
+    params: dict = {}
+    if cp.has_section("params"):
+        params = {k: v for k, v in cp.items("params")}
+    else:
+        params = {k: v for k, v in cp.defaults().items()}
+    return params, cp
+
+
+def _write_ini(path: Path, lines: list[str]) -> None:
+    """原子写（.tmp + replace），CRLF —— AHK 的 IniRead 两种换行都认，但保持一致。"""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(path.suffix + ".tmp")
+    tmp.write_text("".join(l + "\r\n" for l in lines), encoding="utf-8")
+    tmp.replace(path)
+
+
+def _facts(cp: configparser.ConfigParser) -> dict:
+    out: dict = {}
+    if not cp.has_section("facts"):
+        return out
+    for k, v in cp.items("facts"):
+        if k not in FACT_KEYS:
+            continue
+        if k.endswith(("_pid", "_mib", "_mb", "_mib_token")) or k == "kvpt":
+            try:
+                out[k] = float(v) if k == "kvpt" else int(v)
+            except ValueError:
+                out[k] = v
+        else:
+            out[k] = v
+    return out
+
+
+def plan(ini_in: Path, ini_out: Path, json_out: Path | None,
+         results: Path | None = None, native: str = "", lang: str = "zh",
+         lib_dirs: str = "", check_env: bool = False) -> int:
+    errors: list[tuple[str, dict]] = []
+    try:
+        if not ini_in.exists():
+            raise FileNotFoundError(f"入参文件不存在: {ini_in}")
+        raw, cp = _read_ini(ini_in)
+    except Exception as exc:                      # noqa: BLE001 - 读失败也要能渲染
+        raw, cp = {}, configparser.ConfigParser()
+        errors.append(("params.unreadable", {"detail": str(exc)[:120]}))
+
+    r = P.normalize(raw)
+    flags = P.engine_flags(r)
+    slug = P.capacity_slug_suffix(r)
+    seq = int(time.time() * 1000) % 2_000_000_000
+
+    # 边界/建议值：只读服务层写下的 capacity，没有就明说"还没数据"
+    native = native or str(raw.get("native") or "")
+    if results is not None and native:
+        bnd = F.boundary(results, native, r["kv"], r["mtp"], r["mtp_cpu_moe"])
+        ci = F.capacity_info(results, native, r["kv"], slug) if bnd["measured"] else None
+    else:
+        bnd = {"ok": 0, "rec": 0, "key": "", "measured": False}
+        ci = None
+
+    # 预检提醒：facts 由界面查好后一起传进来（这里不做系统探测）
+    # 数字区间校验（纯逻辑，不需要系统信息）
+    for e in E.validate({"ctx": raw.get("ctx"), "port": raw.get("port"),
+                         "vram_reserve_mib": raw.get("reserve"),
+                         "kv_resident": raw.get("kv_resident")}):
+        errors.append((e["code"], e.get("params") or {}))
+    facts = _facts(cp)
+    # 实测点由中间层自己从 capacity 读（界面只传 ctx / 模型 / 模式，不传数字）
+    if ci:
+        facts.setdefault("budget_mib", ci["budget"])
+        if ci.get("verified"):
+            facts.setdefault("seen_ctx", ci["measured_ctx"])
+            facts.setdefault("seen_slots", ci["measured_slots"])
+    warns = PF.warnings({**r, "ctx": raw.get("ctx", r["ctx"])}, facts)
+    if check_env:
+        for e in E.check_env([d for d in lib_dirs.split(";") if d]):
+            (errors if e["hard"] else warns).append(
+                (e["code"], e.get("params") or {}) if e["hard"] else e)
+
+    lines = [
+        "[meta]",
+        f"schema_version={SCHEMA_VERSION}",
+        f"seq={seq}",
+        "generated_at=" + time.strftime("%Y-%m-%dT%H:%M:%S"),
+        "",
+        "[params]",
+    ]
+    for k, v in r.items():
+        lines.append(f"{k}={v}")
+    lines += [
+        "",
+        "[resolved]",
+        f"mtp={r['mtp']}",
+        f"mtp_cpu_moe={r['mtp_cpu_moe']}",
+        f"spec={r['spec']}",
+        f"kv={r['kv']}",
+        f"kv_resident={r['kv_resident']}",
+        f"slug={slug}",
+        "source=estimated",
+        "",
+        "[flags]",
+        f"mtp={' '.join(flags)}",
+        f"slug={slug}",
+        "",
+        "[bounds]",
+        f"measured={'true' if bnd['measured'] else 'false'}",
+        f"ceiling={bnd['ok']}",
+        f"suggested={bnd['rec']}",
+        f"suggested_source={'measured' if bnd['measured'] and bnd['rec'] > 0 else 'none'}",
+        f"ceiling_source={'measured' if bnd['measured'] else 'none'}",
+        f"kvpt={bnd.get('kvpt', 0)}",
+        f"slot_mib={bnd.get('slot_mib', 0)}",
+        f"measured_ctx={bnd.get('measured_ctx', 0)}",
+        f"measured_slots={bnd.get('measured_slots', 0)}",
+        f"capacity_label={F.label(ci, lang) if ci else ''}",
+        f"basis={ci['basis'] if ci else ''}",
+        f"budget={ci['budget'] if ci else 0}",
+        f"ceiling_measured={ci['ceiling'] if ci else 0}",
+        f"measured_verified={'true' if ci and ci.get('verified') else 'false'}",
+    ]
+    for i, w in enumerate(warns, 1):
+        if isinstance(w, tuple):
+            w = {"code": w[0], "params": w[1], "hard": True, "priority": 5}
+        lines += ["", f"[warn.{i}]", f"code={w['code']}",
+                  f"hard={'true' if w['hard'] else 'false'}", f"priority={w.get('priority', 999)}"]
+        for k, v in (w.get("params") or {}).items():
+            lines.append(f"p_{k}={v}")
+    # 弹窗只要"有几条、几条阻塞、最要紧的是哪几条"—— 顺序由中间层给，界面别自己排
+    sm = PF.summary(warns)
+    lines += ["", "[dialog]", f"count={sm['count']}", f"hard={sm['hard_count']}"]
+    for k in range(3):
+        lines.append(f"top{k + 1}=" + (sm["top"][k] if k < len(sm["top"]) else ""))
+    for i, (code, p) in enumerate(errors, 1):
+        lines += ["", f"[errors.{i}]", f"code={code}"]
+        for k, v in p.items():
+            lines.append(f"{k}={v}")
+
+    _write_ini(ini_out, lines)
+
+    if json_out is not None:
+        payload = {
+            "schema_version": SCHEMA_VERSION,
+            "seq": seq,
+            "generated_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
+            "params": r,
+            "resolved": {"mtp": r["mtp"], "mtp_cpu_moe": r["mtp_cpu_moe"], "spec": r["spec"],
+                         "slug": slug, "source": "estimated"},
+            "engine_flags": flags,
+            "bounds": {"ceiling": bnd["ok"], "suggested": bnd["rec"], "measured": bnd["measured"],
+                       "key": bnd["key"], "kvpt": bnd.get("kvpt", 0),
+                       "slot_mib": bnd.get("slot_mib", 0),
+                       "capacity_label": F.label(ci, lang) if ci else ""},
+            "warnings": warns,
+            "errors": [{"code": c, **p} for c, p in errors],
+        }
+        jtmp = json_out.with_suffix(json_out.suffix + ".tmp")
+        jtmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
+        jtmp.replace(json_out)
+
+    return 0 if not errors else 2
+
+
+def observe(ini_out: Path, engine_log: Path | None, server_log: Path | None,
+            run_config: Path | None) -> int:
+    """把一次刷新的运行时数字写进 state.ini 的 [runtime]。"""
+
+    def tail(path: Path | None, limit: int = 60000) -> str:
+        if path is None:
+            return ""
+        try:
+            return path.read_bytes()[-limit:].decode("utf-8", "replace")
+        except OSError:
+            return ""
+
+    snap = O.snapshot(tail(engine_log), tail(server_log), tail(run_config, 20000))
+    lines = ["[runtime]"]
+    for k, v in snap.items():
+        lines.append(f"{k}={'true' if v else 'false'}" if isinstance(v, bool) else f"{k}={v}")
+    lines += ["", "[meta]", f"schema_version={SCHEMA_VERSION}",
+              "seq=" + str(int(time.time() * 1000) % 2_000_000_000)]
+    _write_ini(ini_out, lines)
+    return 0
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(prog="strata.ctl")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    p_plan = sub.add_parser("plan", help="归一化参数、读边界、算预检提醒，写出 state.ini")
+    p_plan.add_argument("--ini-in", required=True)
+    p_plan.add_argument("--ini-out", required=True)
+    p_plan.add_argument("--json", default=None)
+    p_plan.add_argument("--results", default=None, help="results 目录（含 capacity/）")
+    p_plan.add_argument("--native", default="", help="模型路径（缺省读 [params] native）")
+    p_plan.add_argument("--lang", default="zh", choices=["zh", "en"])
+    p_plan.add_argument("--lib-dirs", default="", help="CUDA 运行库目录（; 分隔），用于环境检查")
+    p_plan.add_argument("--env", action="store_true", help="同时做运行环境检查（CUDA DLL / sm 架构）")
+
+    p_obs = sub.add_parser("observe", help="解析日志并把运行时数字写进 state.ini")
+    p_obs.add_argument("--ini-out", required=True)
+    p_obs.add_argument("--engine-log", default=None)
+    p_obs.add_argument("--server-log", default=None)
+    p_obs.add_argument("--run-config", default=None)
+
+    a = ap.parse_args(argv)
+    if a.cmd == "plan":
+        return plan(Path(a.ini_in), Path(a.ini_out),
+                    Path(a.json) if a.json else None,
+                    Path(a.results) if a.results else None, a.native, a.lang,
+                    a.lib_dirs, a.env)
+    if a.cmd == "observe":
+        return observe(Path(a.ini_out),
+                       Path(a.engine_log) if a.engine_log else None,
+                       Path(a.server_log) if a.server_log else None,
+                       Path(a.run_config) if a.run_config else None)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/ctl/env.py b/ctl/env.py
new file mode 100644
index 00000000..221d17f4
--- /dev/null
+++ b/ctl/env.py
@@ -0,0 +1,109 @@
+"""参数校验与环境检查（R9）：判断逻辑都在这里，界面只做文案。
+
+两块内容：
+
+1. `validate(params)` —— 纯区间校验（ctx / port / reserve / kv-resident），不需要任何系统信息。
+2. `check_env(lib_dirs)` —— 运行环境：CUDA 运行库在不在、显卡架构是否与本引擎的 sm_86 匹配。
+
+输出统一是 `[{code, params, hard}]`，界面用 code → 本地化文案。
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+CUDA_DLLS = ("cudart64_12.dll", "cublas64_12.dll")
+BUILT_ARCH = "8.6"          # 本 Release 的引擎按 sm_86 编译
+
+
+def validate(params: dict) -> list[dict]:
+    """数字参数的区间校验（值为空的项跳过，留给调用方的默认值）。"""
+    out: list[dict] = []
+
+    def as_int(v):
+        try:
+            return int(str(v).strip())
+        except (TypeError, ValueError):
+            return None
+
+    ctx = as_int(params.get("ctx"))
+    if params.get("ctx") not in (None, "") and (ctx is None or ctx <= 0):
+        out.append({"code": "ctx.invalid", "params": {"value": params.get("ctx")}, "hard": True})
+
+    port = as_int(params.get("port"))
+    if port is not None and not (1 <= port <= 65535):
+        out.append({"code": "port.invalid", "params": {"value": port}, "hard": True})
+
+    reserve = as_int(params.get("vram_reserve_mib"))
+    if reserve is not None and reserve < 0:
+        out.append({"code": "reserve.invalid", "params": {"value": reserve}, "hard": True})
+
+    resident = as_int(params.get("kv_resident"))
+    if resident is not None and resident != 0 and resident < 20480:
+        # 引擎只接受 0（全部 KV 驻显存）或 >= 20480（流式窗口下限）
+        out.append({"code": "resident.invalid", "params": {"value": resident}, "hard": True})
+    return out
+
+
+def _find_dll(name: str, lib_dirs: list[str]) -> str:
+    """在 lib_dirs 和 PATH 里找一个 DLL。
+
+    不能用 `shutil.which`：Windows 上它按"可执行文件"判定，`.dll` 会返回 None，
+    于是 PATH 里明明有 cudart64_12.dll 也被判成缺失（踩过，弹窗里出现了 env.cudart.missing）。
+    """
+    for d in lib_dirs:
+        if not d:
+            continue
+        p = Path(d) / name
+        if p.is_file():
+            return str(p)
+    for d in os.environ.get("PATH", "").split(os.pathsep):
+        if not d:
+            continue
+        p = Path(d) / name
+        try:
+            if p.is_file():
+                return str(p)
+        except OSError:
+            continue
+    return ""
+
+
+def compute_cap() -> str:
+    """显卡的 compute capability（"8.6" 这种），查不到就返回空串。"""
+    exe = shutil.which("nvidia-smi")
+    if not exe:
+        return ""
+    try:
+        r = subprocess.run([exe, "--query-gpu=compute_cap", "--format=csv,noheader"],
+                           capture_output=True, text=True, timeout=8)
+    except (OSError, subprocess.SubprocessError):
+        return ""
+    line = (r.stdout or "").strip().splitlines()
+    return line[0].strip() if line and r.returncode == 0 else ""
+
+
+def arch_flag(cap: str) -> str:
+    """"8.9" -> "-arch=sm_89"（给"自己编译"提示用）。"""
+    digits = "".join(ch for ch in (cap or "") if ch.isdigit())
+    return f"-arch=sm_{digits}" if digits else "-arch=sm_86"
+
+
+def check_env(lib_dirs: list[str] | None = None, cap: str | None = None) -> list[dict]:
+    """运行环境检查。全部按"提醒"处理：DLL 也可能由驱动从配置的 lib_dirs 注入，
+    界面的 EnvProblems() 才是硬判据（那是本机事实查询，留在界面）。"""
+    lib_dirs = list(lib_dirs or [])
+    out: list[dict] = []
+    for name, code in (("cudart64_12.dll", "env.cudart.missing"),
+                       ("cublas64_12.dll", "env.cublas.missing")):
+        if not _find_dll(name, lib_dirs):
+            out.append({"code": code, "params": {"dll": name}, "hard": False})
+    cap = compute_cap() if cap is None else cap
+    if cap and cap != BUILT_ARCH:
+        out.append({"code": "env.sm.mismatch",
+                    "params": {"cap": cap, "built": BUILT_ARCH, "flag": arch_flag(cap)},
+                    "hard": False})
+    return out
diff --git a/ctl/fit.py b/ctl/fit.py
new file mode 100644
index 00000000..ede04457
--- /dev/null
+++ b/ctl/fit.py
@@ -0,0 +1,131 @@
+"""边界与建议值（P2）：容量文件的唯一读取口。
+
+数据来源是服务层 `serve/prepare.py` 在**引擎加载前**写下的
+`<results>/capacity/<模型>-<kv>-<mtpgpu|mtpcpu|nomtp>.json`。
+
+口径约定（与 prepare 一致，别再自己推）：
+- `ctx_estimate`      服务端按模型元数据 + 剩余显存/内存算的上限（"能启动"的上限）
+- `ctx_suggested`     保留足够专家槽（默认 400 槽）的建议 ctx
+- `ctx_estimate_basis` `vram`（整窗常驻显存）或 `ram`（KV 流式，内存先撞）
+- `expert_slot_mib`   一个专家槽占多少 MiB（量化相关）
+- `kv_measured_mib_per_token`  上次实测的 K/V 每 token 成本（有则优先用）
+
+"能启动 ≠ 能用"：上限再高，槽位被挤光时解码只有几 tok/s，所以建议值按槽位算。
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+
+SAFE = re.compile(r"[^A-Za-z0-9._-]+")
+
+
+def mtp_slug(mtp: str, cpu_moe: str) -> str:
+    if mtp == "off":
+        return "nomtp"
+    return "mtpcpu" if cpu_moe in ("on", "1", "true") else "mtpgpu"
+
+
+def capacity_slug(native: str, kv: str, slug: str) -> str:
+    name = Path(native).name if native else ""
+    return SAFE.sub("_", name) + "-" + SAFE.sub("_", kv) + "-" + slug
+
+
+def capacity_file(results: Path | str, native: str, kv: str, slug: str) -> Path:
+    return Path(results) / "capacity" / (capacity_slug(native, kv, slug) + ".json")
+
+
+def capacity_info(results: Path | str, native: str, kv: str, slug: str) -> dict | None:
+    """读一份 capacity；文件不存在或内容不匹配就返回 None（界面据此说"还没有数据"）。"""
+    f = capacity_file(results, native, kv, slug)
+    try:
+        raw = f.read_text(encoding="utf-8-sig")
+    except OSError:
+        return None
+    try:
+        d = json.loads(raw)
+    except ValueError:
+        return None
+    if str(d.get("model", "")).lower() != Path(native).name.lower():
+        return None
+    if d.get("kv") != kv:
+        return None
+    # 文件名已经带模式；文件里的 mtp_cpu_moe 只做一次兜底校验（nomtp 没有这个键）
+    if slug != "nomtp" and "mtp_cpu_moe" in d:
+        if bool(d["mtp_cpu_moe"]) != (slug == "mtpcpu"):
+            return None
+    mib = d.get("ctx_estimate")
+    if not isinstance(mib, int) or mib <= 0:
+        return None
+    return {
+        "ctx": mib,
+        "basis": d.get("ctx_estimate_basis", "vram"),
+        "suggest": int(d.get("ctx_suggested") or 0),
+        "budget": int(d.get("vram_budget_mib") or 0),
+        "slot_mib": float(d.get("expert_slot_mib") or 0.0),
+        "kvpt": float(d.get("kv_measured_mib_per_token") or 0.0),
+        "ceiling": int(d.get("ctx_ceiling_measured") or 0),
+        "measured_ctx": int(d.get("measured_ctx") or 0),
+        "measured_slots": int(d.get("measured_slots") or 0),
+        # 只有启动器核过"日志确实属于这次启动"才会写 true（见 RecordMeasuredKvpt）
+        "verified": bool(d.get("measured_verified")),
+    }
+
+
+def boundary(results: Path | str, native: str, kv: str, mtp: str, cpu_moe: str) -> dict:
+    """上限（能启动）与建议（保留专家槽）。没有实测数据时 measured=False。"""
+    key = f"{kv}/{mtp}" + ("/cpumoe" if cpu_moe in ("on", "1") else "")
+    ci = capacity_info(results, native, kv, mtp_slug(mtp, cpu_moe)) if native else None
+    if not ci:
+        return {"ok": 0, "rec": 0, "key": key, "measured": False}
+    return {
+        "ok": ci["ctx"],
+        "rec": ci["suggest"] if ci["suggest"] > 0 else ci["ctx"],
+        "key": key,
+        "measured": True,
+        "basis": ci["basis"],
+        "kvpt": ci["kvpt"],
+        "slot_mib": ci["slot_mib"],
+        "measured_ctx": ci["measured_ctx"],
+        "measured_slots": ci["measured_slots"],
+    }
+
+
+def kvpt_for(ci: dict) -> float:
+    """每 token 在显存里占多少 MiB 的 K/V。
+
+    优先用实测（`kv_measured_mib_per_token`，由启动器从引擎日志反推写回）；
+    没有实测就返回 0 —— 宁可不给数字，也不套别的量化测出来的斜率。
+    """
+    return float(ci.get("kvpt") or 0.0)
+
+
+def slots_at(ci: dict, ctx: int) -> int:
+    """这个 ctx 下还能剩多少专家槽（0 = 算不出来，调用方不要说数字）。"""
+    kvpt = kvpt_for(ci)
+    slot = float(ci.get("slot_mib") or 0.0)
+    budget = int(ci.get("budget") or 0)
+    if kvpt <= 0 or slot <= 0 or budget <= 0:
+        return 0
+    left = budget - ctx * kvpt
+    return max(0, int(left / slot))
+
+
+def ctx_for_slots(ci: dict, slots: int) -> int:
+    """要保留 N 个槽，ctx 最多能到多少（0 = 算不出来）。"""
+    kvpt = kvpt_for(ci)
+    slot = float(ci.get("slot_mib") or 0.0)
+    budget = int(ci.get("budget") or 0)
+    if kvpt <= 0 or slot <= 0 or budget <= 0:
+        return 0
+    return max(0, int((budget - slots * slot) / kvpt))
+
+
+def label(ci: dict, lang: str = "zh") -> str:
+    """capacity 的口径说明（内存先撞 / 整窗常驻）。"""
+    en = lang == "en"
+    if ci["basis"] == "ram":
+        return f"RAM bound <= {ci['ctx']} ctx" if en else f"内存上限 ≤{ci['ctx']} ctx"
+    return f"VRAM-window >= {ci['ctx']} ctx" if en else f"整窗常驻 ≥{ci['ctx']} ctx"
diff --git a/ctl/observe.py b/ctl/observe.py
new file mode 100644
index 00000000..b21eb596
--- /dev/null
+++ b/ctl/observe.py
@@ -0,0 +1,83 @@
+"""运行时观测（P3）：只在这里解析引擎/服务端日志。
+
+界面（AHK）每 5 秒刷新一次状态，需要的数字全部来自这里：
+
+    expert cache 544 slots, 0.75 GiB of VRAM   ->  slots / cache_mib
+    drafts accepted 12 of 14                   ->  accept_pct / accept_a / accept_b
+    26.9 tok/s                                 ->  tok_s（取最后一次）
+    context 9216 tokens                        ->  n_ctx（服务端 ready 行）
+    low-RAM mode: ...                          ->  low_ram（或者在 run 配置里有 --mmap-experts）
+
+约定：解析不到就返回 None / 0，**绝不猜**。界面据此决定显示还是留空。
+"""
+
+from __future__ import annotations
+
+import re
+
+SLOTS_RE = re.compile(r"expert cache (\d+) slots(?:, ([\d.]+) GiB)?")
+ACCEPT_RE = re.compile(r"drafts accepted (\d+) of (\d+)")
+TOK_RE = re.compile(r"([\d.]+) tok/s")
+CTX_RE = re.compile(r"context (\d+) tokens")
+
+
+def _last(pattern: re.Pattern, text: str, cast=str):
+    hits = pattern.findall(text or "")
+    if not hits:
+        return None
+    return cast(hits[-1]) if not isinstance(hits[-1], tuple) else hits[-1]
+
+
+def expert_slots(text: str) -> int:
+    """最后一次 "expert cache N slots"。槽数是判断"ctx 有没有把显存吃光"最直接的数。"""
+    hits = SLOTS_RE.findall(text or "")
+    return int(hits[-1][0]) if hits else 0
+
+
+def cache_mib(text: str) -> int:
+    hits = SLOTS_RE.findall(text or "")
+    if not hits or not hits[-1][1]:
+        return 0
+    return int(round(float(hits[-1][1]) * 1024))
+
+
+def accept(text: str) -> dict:
+    """最后一次 "drafts accepted A of B" -> {pct, a, b}；B=0 视作没有数据。"""
+    hits = ACCEPT_RE.findall(text or "")
+    for a, b in reversed(hits):
+        a, b = int(a), int(b)
+        if b > 0:
+            return {"pct": round(a * 100 / b), "a": a, "b": b}
+    return {"pct": 0, "a": 0, "b": 0}
+
+
+def tok_s(text: str) -> float:
+    hits = TOK_RE.findall(text or "")
+    return float(hits[-1]) if hits else 0.0
+
+
+def n_ctx(server_text: str) -> int:
+    v = _last(CTX_RE, server_text or "", int)
+    return int(v) if v else 0
+
+
+def low_ram(server_text: str, run_config_text: str = "") -> bool:
+    """low-RAM 的判据：run 配置里显式要求，或服务端日志里出现过 low-RAM 提示。"""
+    if run_config_text and ("--mmap-experts" in run_config_text or "--resident-experts" in run_config_text):
+        return True
+    return "low-RAM mode:" in (server_text or "")
+
+
+def snapshot(engine_text: str = "", server_text: str = "", run_config_text: str = "") -> dict:
+    """一次刷新需要的全部运行时数字（缺的就是 0 / False）。"""
+    a = accept(engine_text)
+    return {
+        "slots": expert_slots(engine_text),
+        "cache_mib": cache_mib(engine_text),
+        "accept_pct": a["pct"],
+        "accept_a": a["a"],
+        "accept_b": a["b"],
+        "tok_s": tok_s(engine_text),
+        "n_ctx": n_ctx(server_text),
+        "low_ram": low_ram(server_text, run_config_text),
+    }
diff --git a/ctl/params.py b/ctl/params.py
new file mode 100644
index 00000000..bae481bc
--- /dev/null
+++ b/ctl/params.py
@@ -0,0 +1,82 @@
+"""参数归一化：`mtp_mode` / `kv` / `resident` / `spec` 的唯一真相源。
+
+界面（AHK）只把控件值原样传进来，派生规则全部在这里。规则与实测依据：
+
+    mtp_mode=off  -> mtp=off,  mtp_cpu_moe=off, 无 --mtp 参数（保留 --spec，native pack 要求 T>=2）
+    mtp_mode=gpu  -> mtp=on,   mtp_cpu_moe=off, MTP 专家层在显存（439 MiB 绑定）
+    mtp_mode=cpu  -> mtp=on,   mtp_cpu_moe=on,  MTP 专家层在主机内存（127 MiB 绑定，省 312 MiB）
+
+实测（2026-11-24，4 GB 卡 / IQ3_S）：三种模式可用显存依次 1424 / 1736 / 1863 MiB。
+"""
+
+from __future__ import annotations
+
+VALID_MTP_MODES = ("gpu", "cpu", "off")
+VALID_KV = ("k8v4", "q4_0", "int8", "fp16")
+
+# mtp_mode -> (mtp, mtp_cpu_moe, spec)
+# spec 的取值：native (IQ) pack 硬要求 T >= 2；cpu 模式沿用长模式实测最优 2，其余 3
+_MTP_TABLE = {
+    "gpu": ("on", "off", 3),
+    "cpu": ("on", "on", 2),
+    "off": ("off", "off", 3),
+}
+
+
+def normalize(params: dict) -> dict:
+    """把界面参数归一化成"引擎真正会收到的东西"。
+
+    入参（缺省即可）：mtp_mode, kv, kv_resident, ctx, reserve, spec
+    返回：mtp, mtp_cpu_moe, spec, kv, kv_resident + 原样带回的 ctx/reserve
+    """
+    mtp_mode = str(params.get("mtp_mode") or "gpu").strip().lower()
+    if mtp_mode not in VALID_MTP_MODES:
+        mtp_mode = "gpu"
+    kv = str(params.get("kv") or "k8v4").strip().lower()
+    if kv not in VALID_KV:
+        kv = "k8v4"
+
+    mtp, cpu_moe, spec_default = _MTP_TABLE[mtp_mode]
+    spec_raw = params.get("spec")
+    try:
+        spec = int(spec_raw) if spec_raw not in (None, "") else spec_default
+    except (TypeError, ValueError):
+        spec = spec_default
+    if spec < 2:                      # native pack 的硬要求
+        spec = 2
+
+    try:
+        resident = int(params.get("kv_resident") or 0)
+    except (TypeError, ValueError):
+        resident = 0
+    if resident != 0 and resident < 20480:
+        resident = 0                  # 引擎只接受 0 或 >= 20480
+
+    return {
+        "mtp_mode": mtp_mode,
+        "mtp": mtp,
+        "mtp_cpu_moe": cpu_moe,
+        "spec": spec,
+        "kv": kv,
+        "kv_resident": resident,
+        "ctx": params.get("ctx", ""),
+        "reserve": params.get("reserve", ""),
+    }
+
+
+def capacity_slug_suffix(r: dict) -> str:
+    """capacity 文件名后缀：-mtpgpu / -mtpcpu / -nomtp（三种模式互不覆盖）。"""
+    if r["mtp"] == "off":
+        return "nomtp"
+    return "mtpcpu" if r["mtp_cpu_moe"] == "on" else "mtpgpu"
+
+
+def engine_flags(r: dict) -> list[str]:
+    """按归一化结果生成 MTP 相关参数（其余参数仍由界面/驱动拼）。"""
+    flags: list[str] = []
+    if r["mtp"] == "off":
+        flags += ["--mtp", "off"]     # 驱动会把它翻译成"不带 --mtp"
+    if r["mtp_cpu_moe"] == "on":
+        flags += ["--mtp-cpu-moe", "1"]
+    flags += ["--spec", str(r["spec"])]
+    return flags
diff --git a/ctl/preflight.py b/ctl/preflight.py
new file mode 100644
index 00000000..bfa47c88
--- /dev/null
+++ b/ctl/preflight.py
@@ -0,0 +1,92 @@
+"""预检提醒（P4）：判定逻辑在这里，文案在界面。
+
+为什么 errors 没搬过来：它们全是"本机事实查询"（引擎/服务层/驱动/模板在不在），
+界面本来就拿着这些路径，搬过来只会多一层传参和一次进程启动，没有收益。
+**需要判断、比较、组合规则的部分**（显存预算、ctx 与上限/建议的关系、内存余量、
+已有实例、护栏）才是真正容易写错的地方，全部集中在这里，输出机器码 + 参数。
+
+调用方（AHK）负责：
+1. 用现成的查询结果组 `facts`（不要在这里做系统探测）；
+2. 把 `code` 翻译成中/英文案（i18n 留在有语言的那一层）；
+3. `hard=True` 的条目当成"不能启动"，其余当提醒。
+"""
+
+from __future__ import annotations
+
+# 与 serve/prepare.py 的口径一致
+VRAM_BUDGET_FLOOR_MIB = 700     # 权重 + reserve 之后低于这个值，MTP 专家再放显存放不下 prefill 缓冲
+MODEL_NEED_MB = 12288           # 专家约 12 GiB
+RAM_ABORT_MB = 500              # 护栏阈值
+SLOT_TARGET = 400               # 建议保留的专家槽数
+
+
+def warnings(params: dict, facts: dict) -> list[dict]:
+    """返回 [{code, params, hard}]；顺序稳定，界面按顺序显示。"""
+    out: list[dict] = []
+    mtp_cpu = facts.get("mtp_cpu_moe", params.get("mtp_cpu_moe")) in ("on", True, 1)
+
+    if not facts.get("model_path"):
+        out.append({"code": "model.missing", "params": {}, "hard": False, "priority": 10})
+
+    pack = facts.get("pack_problem") or ""
+    if pack:
+        out.append({"code": "pack.prepare", "params": {"detail": pack}, "hard": False, "priority": 40})
+
+    budget = int(facts.get("budget_mib") or 0)
+    if budget > 0 and budget < VRAM_BUDGET_FLOOR_MIB and not mtp_cpu:
+        out.append({"code": "vram.budget.low", "params": {"budget": budget}, "hard": False, "priority": 20})
+
+    ceiling = int(facts.get("ceiling") or 0)
+    suggested = int(facts.get("suggested") or 0)
+    ctx = int(params.get("ctx") or 0)
+    # 只用**本机实测点**判断：ctx->槽位做线性外推的误差极大（实测 20480 是 400+ 槽，
+    # 而按 budget/kvpt 外推会得到 900+），所以没有实测点就不出这条提醒。
+    seen_ctx = int(facts.get("seen_ctx") or 0)
+    seen_slots = int(facts.get("seen_slots") or 0)
+    if ceiling > 0 and ctx > ceiling:
+        out.append({"code": "ctx.over.ceiling",
+                    "params": {"ctx": ctx, "ceiling": ceiling}, "hard": False, "priority": 30})
+    elif seen_ctx > 0 and seen_slots > 0 and seen_ctx <= ctx and seen_slots < SLOT_TARGET:
+        out.append({"code": "ctx.starves.cache",
+                    "params": {"ctx": ctx, "seen_ctx": seen_ctx, "seen_slots": seen_slots,
+                               "target": SLOT_TARGET},
+                    "hard": False, "priority": 50})
+
+    ram_free = int(facts.get("ram_free_mb") if facts.get("ram_free_mb") is not None else -1)
+    ram_total = int(facts.get("ram_total_mb") or 0)
+    if ram_free >= 0:
+        if ram_free < RAM_ABORT_MB:
+            out.append({"code": "ram.critical",
+                        "params": {"free": ram_free, "abort": RAM_ABORT_MB}, "hard": True, "priority": 0})
+        elif ram_free < MODEL_NEED_MB:
+            out.append({"code": "ram.low",
+                        "params": {"free": ram_free, "total": ram_total, "need": MODEL_NEED_MB,
+                                   "abort": RAM_ABORT_MB}, "hard": False, "priority": 25})
+
+    if facts.get("engine_pid") or facts.get("serve_pid"):
+        out.append({"code": "instance.running",
+                    "params": {"engine": facts.get("engine_pid") or "-",
+                               "serve": facts.get("serve_pid") or "-"}, "hard": False, "priority": 60})
+    if facts.get("guard_pid"):
+        out.append({"code": "guard.running",
+                    "params": {"pid": facts["guard_pid"]}, "hard": False, "priority": 70})
+    # 顺序也是逻辑：阻塞项（priority 0）在前，其余按 priority 升序
+    out.sort(key=lambda i: (i.get("priority", 999), i.get("code", "")))
+    return out
+
+
+def blocking(items: list[dict]) -> bool:
+    return any(i.get("hard") for i in items)
+
+
+def summary(items: list[dict], top: int = 3) -> dict:
+    """弹窗要的"先说什么"：条数、阻塞条数、最要紧的几条 code（按 priority 升序）。
+
+    界面据此决定弹窗的行数与顺序，不必自己比较规则 —— 那正是容易写错的地方。
+    """
+    ordered = sorted(items, key=lambda i: (i.get("priority", 999), i.get("code", "")))
+    return {
+        "count": len(ordered),
+        "hard_count": sum(1 for i in ordered if i.get("hard")),
+        "top": [i["code"] for i in ordered[:top]],
+    }
