+
+def facts(**over):
+    base = {"model_path": "m.gguf", "budget_mib": 1200, "ceiling": 74752, "suggested": 8192,
+            "ram_free_mb": 20000, "ram_total_mb": 32768, "engine_pid": 0, "serve_pid": 0,
+            "guard_pid": 0, "pack_problem": ""}
+    base.update(over)
+    return base
