+def ensure_lowram(cfg: dict, log=print) -> bool:
+    """Put the machine in the engine's low-RAM mode when the experts cannot be copied into RAM.
+
+    Unless the user asked for something specific, the engine otherwise copies *all* experts into
+    pinned RAM (12-15 GiB here) and a 16 GB PC dies or gets killed by the RAM guard.  With
+    --mmap-experts they are mapped from the model file instead: the OS file cache holds what the
+    GPU's expert cache does not, and it can hand that memory back under pressure.
+
+    Cost (measured, upstream and here): decode drops to roughly a third on a cold cache
+    (~12 tok/s vs ~40 on this 4 GB card), so it is only chosen when the arena genuinely does not fit.
+    STRATA_FORCE_LOWRAM=1 forces it on for testing; STRATA_NO_BUDGET=1 skips it.
+    """
+    if os.environ.get("STRATA_NO_BUDGET") == "1":
+        return False
+    args = list(cfg.get("args") or [])
+    native = _arg(args, "--native")
+    if not native:
+        return False
+    gguf = pathlib.Path(native)
+    if not gguf.is_file():
+        return False
+    if any(a in args for a in ("--mmap-experts", "--resident-experts", "--shared-expert-arena")):
+        return False
+    try:
+        import psutil
+        vm = psutil.virtual_memory()
+        avail, total = vm.available / 2**20, vm.total / 2**20
+    except Exception:
+        return False
+    pack = _arg(args, "--pack")
+    exp = model_expert_bytes(pathlib.Path(pack) if pack and "%" not in pack else None, gguf)
+    if not exp:
+        return False
+    exp_mib = exp / 2**20
+    forced = os.environ.get("STRATA_FORCE_LOWRAM") == "1"
+    if not forced and not lowram_needed(avail, exp_mib, total):
+        return False
+
+    args.append("--mmap-experts")
+    # 内存都装不下专家了，parking 池纯属自杀：关掉（引擎允许 0）
+    try:
+        if "--conversation-cache-mib" in args:
+            args[args.index("--conversation-cache-mib") + 1] = "0"
+    except (IndexError, ValueError):
+        pass
+    cfg["args"] = args
+    log(f"[prepare] low-RAM mode: RAM {avail:.0f} MiB available / {total:.0f} MiB total cannot hold the "
+        f"{exp_mib:.0f} MiB of experts plus {LOWRAM_SPARE_MIB} MiB for the system -> --mmap-experts: the experts "
+        f"are mapped from the model file and the OS file cache streams them; parked conversations off. "
+        f"WARNING: decode is roughly a third of the resident mode while that cache is cold")
+    return True
+
