new file mode 100644
index 00000000..6377b702
--- /dev/null
+++ b/ctl/tests/test_observe.py
@@ -0,0 +1,94 @@
+"""测试：运行时观测（P3）。日志片段取自真实运行（2026-11-25 的三次启动 + 历史 low-RAM 段）。"""
+
+import unittest
+
+from strata.ctl import observe as O
+
+# 4 槽（大 ctx 挤光缓存）——实测 7.5 tok/s
+LOG_STARVED = """strata generate: expert cache 4 slots, 0.01 GiB of VRAM; policy is
+strata generate: drafts accepted 3 of 4
+strata generate: 7.5 tok/s
+"""
+
+# 544 槽（cpu 模式）
+LOG_CPU = """strata generate: expert cache 544 slots, 0.75 GiB of VRAM; policy is
+strata generate: drafts accepted 12 of 14
+strata generate: 37.6 tok/s
+"""
+
+# 两次启动，取最后一次
+LOG_TWICE = """strata generate: expert cache 316 slots, 0.43 GiB of VRAM; policy is
+strata generate: expert cache 584 slots, 0.80 GiB of VRAM; policy is
+strata generate: 26.9 tok/s
+"""
+
+SERVER = "ready: http://127.0.0.1:1339/v1  (context 9216 tokens)"
+SERVER_LOWRAM = ("[prepare] low-RAM mode: mapping the experts from the model files (about 15 GB)\n"
+                 + SERVER)
+
+
+
+class TestSlots(unittest.TestCase):
+    def test_starved(self):
+        self.assertEqual(O.expert_slots(LOG_STARVED), 4)
+        self.assertEqual(O.cache_mib(LOG_STARVED), 10)
+
+    def test_cpu(self):
+        self.assertEqual(O.expert_slots(LOG_CPU), 544)
+        self.assertEqual(O.cache_mib(LOG_CPU), 768)
+
+    def test_last_wins(self):
+        self.assertEqual(O.expert_slots(LOG_TWICE), 584)
+
+    def test_absent(self):
+        self.assertEqual(O.expert_slots("no model loaded yet"), 0)
+        self.assertEqual(O.cache_mib(""), 0)
+
+
+class TestAccept(unittest.TestCase):
+    def test_pct(self):
+        a = O.accept(LOG_CPU)
+        self.assertEqual((a["a"], a["b"], a["pct"]), (12, 14, 86))
+
+    def test_zero_total_ignored(self):
+        self.assertEqual(O.accept("drafts accepted 0 of 0")["pct"], 0)
+
+    def test_last_wins(self):
+        txt = "drafts accepted 1 of 2\ndrafts accepted 9 of 10"
+        self.assertEqual(O.accept(txt)["pct"], 90)
+
+
+class TestSpeedAndCtx(unittest.TestCase):
+    def test_tok_s(self):
+        self.assertAlmostEqual(O.tok_s(LOG_CPU), 37.6, places=1)
+
+    def test_n_ctx(self):
+        self.assertEqual(O.n_ctx(SERVER), 9216)
+        self.assertEqual(O.n_ctx(""), 0)
+
+    def test_low_ram(self):
+        self.assertTrue(O.low_ram(SERVER_LOWRAM))
+        self.assertFalse(O.low_ram(SERVER))
+        self.assertTrue(O.low_ram(SERVER, '{"args": ["--mmap-experts"]}'))
+        self.assertFalse(O.low_ram(SERVER, '{"args": []}'))
+
+
+class TestSnapshot(unittest.TestCase):
+    def test_full(self):
+        s = O.snapshot(LOG_CPU, SERVER)
+        self.assertEqual(s["slots"], 544)
+        self.assertEqual(s["accept_pct"], 86)
+        self.assertAlmostEqual(s["tok_s"], 37.6, places=1)
+        self.assertEqual(s["n_ctx"], 9216)
+        self.assertFalse(s["low_ram"])
+
+    def test_empty(self):
+        s = O.snapshot()
+        self.assertEqual(s["slots"], 0)
+        self.assertEqual(s["accept_pct"], 0)
+        self.assertEqual(s["n_ctx"], 0)
+        self.assertFalse(s["low_ram"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/ctl/tests/test_params.py b/ctl/tests/test_params.py
new file mode 100644
index 00000000..201d67fd
--- /dev/null
+++ b/ctl/tests/test_params.py
@@ -0,0 +1,142 @@
+"""测试：参数归一化（P1）+ 边界/建议值读取（P2）。"""
+
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from strata.ctl import fit
+from strata.ctl import params as P
+
+
+class TestMtpDerivation(unittest.TestCase):
+    def test_gpu(self):
+        r = P.normalize({"mtp_mode": "gpu"})
+        self.assertEqual(r["mtp"], "on")
+        self.assertEqual(r["mtp_cpu_moe"], "off")
+        self.assertEqual(P.capacity_slug_suffix(r), "mtpgpu")
+
+    def test_cpu(self):
+        r = P.normalize({"mtp_mode": "cpu"})
+        self.assertEqual(r["mtp"], "on")
+        self.assertEqual(r["mtp_cpu_moe"], "on")
+        self.assertEqual(P.capacity_slug_suffix(r), "mtpcpu")
+
+    def test_off(self):
+        r = P.normalize({"mtp_mode": "off"})
+        self.assertEqual(r["mtp"], "off")
+        self.assertEqual(r["mtp_cpu_moe"], "off")
+        self.assertEqual(P.capacity_slug_suffix(r), "nomtp")
+
+
+class TestSpecAndFlags(unittest.TestCase):
+    def test_spec_floor(self):
+        self.assertEqual(P.normalize({"mtp_mode": "gpu", "spec": 0})["spec"], 2)
+        self.assertEqual(P.normalize({"mtp_mode": "gpu", "spec": 1})["spec"], 2)
+
+    def test_spec_passthrough(self):
+        self.assertEqual(P.normalize({"mtp_mode": "gpu", "spec": 5})["spec"], 5)
+
+    def test_flags_cpu(self):
+        f = P.engine_flags(P.normalize({"mtp_mode": "cpu"}))
+        self.assertIn("--mtp-cpu-moe", f)
+        self.assertEqual(f[f.index("--mtp-cpu-moe") + 1], "1")
+
+    def test_flags_gpu_no_cpumoe(self):
+        self.assertNotIn("--mtp-cpu-moe", P.engine_flags(P.normalize({"mtp_mode": "gpu"})))
+
+    def test_flags_off(self):
+        f = P.engine_flags(P.normalize({"mtp_mode": "off"}))
