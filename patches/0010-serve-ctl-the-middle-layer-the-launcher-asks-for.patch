+
+class TestScenarios(unittest.TestCase):
+    def test_normal(self):
+        self.assertEqual(codes(PF.warnings(P, facts())), [])
+
+    def test_vram_budget_low(self):
+        out = PF.warnings(P, facts(budget_mib=650))
+        self.assertIn("vram.budget.low", codes(out))
+        # cpu 模式已经让出了 MTP 那 300 MiB，不再提醒
+        self.assertNotIn("vram.budget.low", codes(PF.warnings({**P, "mtp_cpu_moe": "on"}, facts(budget_mib=650))))
+
+    def test_ctx_over_ceiling(self):
+        out = PF.warnings({**P, "ctx": 90000}, facts())
+        self.assertIn("ctx.over.ceiling", codes(out))
+        self.assertNotIn("ctx.starves.cache", codes(out))   # 超上限只说上限，不重复
+
+    def test_ctx_starves_cache_from_measurement(self):
+        # 只用实测点：本机在 40960 那次量到 120 槽（<400）-> 报；ctx 比它小就不报
+        out = PF.warnings({**P, "ctx": 49152}, facts(seen_ctx=40960, seen_slots=120))
+        self.assertIn("ctx.starves.cache", codes(out))
+        self.assertEqual(out[0]["params"]["target"], 400)
+        self.assertEqual(out[0]["params"]["seen_slots"], 120)
+        # 用户实测：IQ3_S gpu @20480 是 657 槽 -> 不该报
+        self.assertNotIn("ctx.starves.cache",
+                         codes(PF.warnings({**P, "ctx": 20480}, facts(seen_ctx=20480, seen_slots=657))))
+
+    def test_no_measurement_no_warning(self):
+        # 没有实测点就不猜（ctx 远大于建议值也不报"挤光缓存"）
+        self.assertNotIn("ctx.starves.cache",
+                         codes(PF.warnings({**P, "ctx": 65536}, facts(suggested=16384))))
+
+    def test_ram_low_and_critical(self):
+        low = PF.warnings(P, facts(ram_free_mb=6000))
+        self.assertIn("ram.low", codes(low))
+        self.assertFalse(PF.blocking(low))
+        crit = PF.warnings(P, facts(ram_free_mb=300))
+        self.assertIn("ram.critical", codes(crit))
+        self.assertTrue(PF.blocking(crit))
+
+    def test_instances_and_guard(self):
+        out = PF.warnings(P, facts(engine_pid=1234, serve_pid=5678, guard_pid=9012))
+        self.assertIn("instance.running", codes(out))
+        self.assertIn("guard.running", codes(out))
+        self.assertEqual(out[0]["params"]["engine"], 1234)
+
+    def test_model_and_pack(self):
+        out = PF.warnings(P, facts(model_path="", pack_problem="need a pack"))
+        self.assertEqual(codes(out)[:2], ["model.missing", "pack.prepare"])
+
+    def test_priority_order_and_summary(self):
+        out = PF.warnings(P, facts(model_path="", ram_free_mb=300, guard_pid=7))
+        s = PF.summary(out)
+        self.assertEqual(s["count"], 3)
+        self.assertEqual(s["hard_count"], 1)
+        # ram.critical(0) 先于 model.missing(10) 先于 guard.running(70)
+        self.assertEqual(s["top"], ["ram.critical", "model.missing", "guard.running"])
+
+    def test_priority_field_present(self):
+        for item in PF.warnings(P, facts(budget_mib=600, ram_free_mb=300)):
+            self.assertIn("priority", item)
+
+    def test_unknown_ram_is_skipped(self):
+        # ram_free_mb=None 表示"查不到"，不能误报
+        self.assertEqual(codes(PF.warnings(P, facts(ram_free_mb=None))), [])
+
+
+class TestValidate(unittest.TestCase):
