From 10ba3195f2e63a7b126169361de3191530012b5f Mon Sep 17 00:00:00 2001
From: strata-4gb <strata-4gb@localhost>
Date: Mon, 23 Nov 2026 15:27:35 +0800
Subject: [PATCH 4/9] serve/tools: prepare the pack a GGUF needs, before the
 engine starts

The engine reads a pack (dense weights in its layout, tensor index, tokenizer, expert
offsets). None of that is user data: it is derived from the GGUF, so asking the user (or
the launcher) to produce it is the wrong layer. serve/prepare.py owns it now.

- serve/prepare.py: ensure_pack(cfg) -- if --pack's native_experts.txt names a different
  GGUF (or there is no pack), build one with tools/make_pack.py, then repoint --pack and
  tokenizer. Idempotent; 3 s / 65 MB measured; a failure never kills the server
- serve/server.py: call it right after the config is read, before the tokenizer check
- tools/make_pack.py: derive <family>-<quant> from the GGUF name, run iq_pack.py (qwen36
  with --compat-bf16), find iq_pack.py in the checkout, skip when the pack already exists
---
 serve/prepare.py   | 125 +++++++++++++++++++++++++++++++++++
 serve/server.py    |  12 ++++
 tools/make_pack.py | 161 +++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 298 insertions(+)
 create mode 100644 serve/prepare.py
 create mode 100644 tools/make_pack.py

diff --git a/serve/prepare.py b/serve/prepare.py
new file mode 100644
index 00000000..da69bbbc
--- /dev/null
+++ b/serve/prepare.py
@@ -0,0 +1,125 @@
+"""Make sure the pack a GGUF needs exists, before the engine starts.
+
+The engine reads a *pack*: dense weights in its layout, a tensor index, the tokenizer and
+the byte offsets of every layer's experts inside the GGUF.  None of that is user data --
+it is derived from the GGUF -- so the launcher has no business building it: the launcher
+names a model file, and this layer prepares it (3 s / ~65 MB, measured).
+
+Called once from server.py right before the engine is spawned.  Idempotent: when the pack
+already names the same GGUF, nothing happens.
+"""
+from __future__ import annotations
+
+import os
+import pathlib
+import re
+import subprocess
+import sys
+
+# Qwen3.6-35B-A3B-UD-IQ3_S -> UD-IQ3_S
+QUANT_RE = re.compile(r"((?:UD-)?(?:IQ\d[A-Za-z0-9_]*|Q\d(?:_[A-Za-z0-9]+)*))$")
+
+
+def _arg(args: list[str], flag: str) -> str:
+    try:
+        return args[args.index(flag) + 1]
+    except (ValueError, IndexError):
+        return ""
+
+
+def header_gguf(pack: pathlib.Path | str) -> str:
+    """The GGUF file name that this pack's native_experts.txt points into ('' if unknown)."""
+    f = pathlib.Path(pack) / "native_experts.txt"
+    if not f.is_file():
+        return ""
+    try:
+        first = f.read_text(encoding="utf-8", errors="ignore").splitlines()[0]
+    except (OSError, IndexError):
+        return ""
+    m = re.search(r"absolute offsets in ([^,;)]+)", first)
+    return m.group(1).strip() if m else ""
+
+
+def pack_tag(gguf: pathlib.Path, family: str) -> str:
+    m = QUANT_RE.search(gguf.stem)
+    return f"{family}-{(m.group(1) if m else gguf.stem)}".lower()
+
+
+def _make_pack_script(root: pathlib.Path) -> pathlib.Path | None:
+    for c in (root / "tools" / "make_pack.py",
+              pathlib.Path(__file__).resolve().parent.parent / "tools" / "make_pack.py",
+              pathlib.Path(__file__).resolve().parent / "make_pack.py"):
+        if c.is_file():
+            return c
+    return None
+
+
+def ensure_pack(cfg: dict, family: str = "qwen36", log=print) -> bool:
+    """Prepare cfg['args'] so that its --pack matches its --native.  True if we changed it."""
+    args = list(cfg.get("args") or [])
+    native = _arg(args, "--native")
+    if not native:
+        return False
+    gguf = pathlib.Path(native)
+    if not gguf.is_file():
+        log(f"[prepare] --native 不存在: {gguf}（跳过 pack 检查）")
+        return False
+
+    cur = _arg(args, "--pack")
+    cur_dir = pathlib.Path(cur) if cur else None
+    if cur_dir and header_gguf(cur_dir).lower() == gguf.name.lower():
+        return False                                     # already the right pack
+
+    root = (cur_dir.parent if cur_dir else
+            pathlib.Path(cfg.get("cwd") or ".") / "packs")
+    target = root / pack_tag(gguf, family)
+
+    if cur_dir and header_gguf(cur_dir) == "" and cur_dir.is_dir():
+        target = cur_dir                                 # an empty/incomplete pack dir: fill it
+
+    log(f"[prepare] 这个 GGUF 还没有匹配的 pack: {gguf.name}")
+    log(f"[prepare]   {('现有 pack 指向 ' + header_gguf(cur_dir)) if cur_dir and header_gguf(cur_dir) else '没有现成 pack'}")
+    log(f"[prepare]   -> {target}（约 3 秒，专家仍留在 GGUF 里）")
+
+    script = _make_pack_script(pathlib.Path(cfg.get("cwd") or "."))
+    if script is None:
+        log("[prepare] 找不到 tools/make_pack.py，无法自动生成；"
+            "可以手动: python tools/make_pack.py --gguf <模型.gguf> --packs <packs 目录>")
+        return False
+
+    cmd = [sys.executable, str(script), "--gguf", str(gguf), "--packs", str(root), "--family", family]
+    try:
+        rc = subprocess.call(cmd)
+    except OSError as e:
+        log(f"[prepare] 生成 pack 失败: {e}")
+        return False
+    if rc != 0:
+        log(f"[prepare] make_pack.py 退出码 {rc}；引擎大概率起不来（日志见上）")
+        return False
+    if header_gguf(target).lower() != gguf.name.lower():
+        log(f"[prepare] 生成后仍对不上: {target} 指向 {header_gguf(target) or '(空)'}")
+        return False
+
+    # 改写 cfg：--pack，以及指向旧 pack 内部的 tokenizer
+    if "--pack" in args:
+        args[args.index("--pack") + 1] = str(target)
+    else:
+        args = ["--pack", str(target)] + args
+    cfg["args"] = args
+    # tokenizer 永远是 pack 的一部分（由同一个 GGUF 派生），换 pack 就跟着换
+    cfg["tokenizer"] = str(target / "tokenizer")
+    log(f"[prepare] tokenizer -> {cfg['tokenizer']}")
+    log(f"[prepare] pack 就绪: {target}")
+    return True
+
+
+if __name__ == "__main__":                               # manual: prepare.py <run-config.json>
+    import json
+    import sys
+    path = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else "strata-qwen36-run.json")
+    data = json.loads(path.read_text(encoding="utf-8"))
+    changed = ensure_pack(data, family=os.environ.get("STRATA_FAMILY", "qwen36"))
+    if changed:
+        path.write_text(json.dumps(data, indent=1, ensure_ascii=False), encoding="utf-8")
+        print(f"[prepare] {path} 已更新")
+    sys.exit(0)
diff --git a/serve/server.py b/serve/server.py
index 6805d03d..afa06e6a 100644
--- a/serve/server.py
+++ b/serve/server.py
@@ -6309,6 +6309,18 @@ def main() -> int:
     a = ap.parse_args()
     cfg = json.loads(Path(a.config).read_text(encoding="utf-8-sig")) if a.config else {}   # Notepad adds a BOM
     lift_reasoning_effort_arg(cfg)
+    # A GGUF without its pack: the pack is derived data (dense weights + index + tokenizer + expert
+    # offsets), so it is prepared here -- the launcher only names the model.  Idempotent and fast
+    # (3 s / ~65 MB); it also repoints --pack and tokenizer when the model changed.
+    pack_changed = False
+    if cfg.get("args"):
+        try:
+            from serve import prepare as prepare_mod
+            pack_changed = prepare_mod.ensure_pack(cfg, log=lambda m: print(m, flush=True))
+        except Exception as e:                      # never let model preparation kill the server
+            print(f"[strata] pack preparation failed: {e}", flush=True)
+    if pack_changed and cfg.get("tokenizer"):
+        a.tokenizer = cfg["tokenizer"]
     # 日志时间戳：默认开，配置里 "log_timestamps": false 关掉（服务端 print 与引擎 stderr 都加 HH:MM:SS）
     global LOG_TIMESTAMPS
     LOG_TIMESTAMPS = cfg.get("log_timestamps", True) is not False
diff --git a/tools/make_pack.py b/tools/make_pack.py
new file mode 100644
index 00000000..55818fa8
--- /dev/null
+++ b/tools/make_pack.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Build the small Strata "pack" for one GGUF file.
+
+A pack is *not* a copy of the model: it is the dense tensors in the engine's
+layout (dense.bin, tens of MB), a tensor index (index.txt), the tokenizer, and
+native_experts.txt -- the byte offsets of every layer's experts inside the GGUF.
+The 12 GB of routed experts stay in the GGUF and are read in place, which is why
+this takes seconds instead of hours.
+
+    python tools/make-pack.py --gguf  D:\\models\\Qwen3.6-35B-A3B-UD-IQ3_S.gguf
+    python tools/make-pack.py --gguf  ... --packs D:\\packs --force
+
+The pack lands in <packs>/<family>-<quant> (default <packs> = ./packs), the same
+name upstream's setup.py uses.  Needs Python 3.10+ and numpy; the llama.cpp
+`gguf` python package is only needed for files whose small projections are
+quantized (UD-Q4_K_XL and friends) instead of F32.
+
+Exit codes: 0 ok, 2 bad arguments, 3 pack tool missing, 4 build failed,
+5 the pack does not point at the GGUF we asked for.
+"""
+from __future__ import annotations
+
+import argparse
+import os
+import pathlib
+import re
+import subprocess
+import sys
+import time
+
+HERE = pathlib.Path(__file__).resolve().parent
+
+
+def find_iq_pack() -> pathlib.Path | None:
+    """iq_pack.py lives in the Strata checkout's tools/, not necessarily next to us."""
+    cands = [HERE / "iq_pack.py"]
+    env = os.environ.get("STRATA_ROOT")
+    if env:
+        cands.append(pathlib.Path(env) / "tools" / "iq_pack.py")
+    cands += [HERE.parent / "strata" / "tools" / "iq_pack.py",      # <install>/tools -> <install>/strata
+              HERE.parent.parent / "strata" / "tools" / "iq_pack.py",
+              HERE.parent / "iq_pack.py"]
+    for c in cands:
+        if c.is_file():
+            return c
+    return None
+
+
+IQ_PACK = find_iq_pack() or (HERE / "iq_pack.py")
+
+# family -> extra iq_pack flags (mirrors setup.py's "pack_args")
+FAMILY_ARGS = {
+    "qwen36": ["--compat-bf16"],
+    "qwen3":  ["--compat-bf16"],
+    "ornith": ["--compat-bf16"],
+}
+
+QUANT_RE = re.compile(r"((?:UD-)?(?:IQ\d[A-Za-z0-9_]*|Q\d(?:_[A-Za-z0-9]+)*))$")
+
+
+def quant_of(stem: str) -> str:
+    """Qwen3.6-35B-A3B-UD-IQ3_S -> UD-IQ3_S"""
+    m = QUANT_RE.search(stem)
+    return m.group(1) if m else stem
+
+
+def pack_tag(gguf: pathlib.Path, family: str) -> str:
+    return f"{family}-{quant_of(gguf.stem)}".lower()
+
+
+def native_header_gguf(pack: pathlib.Path) -> str:
+    """The GGUF file name that native_experts.txt points into ('' if unknown)."""
+    f = pack / "native_experts.txt"
+    if not f.exists():
+        return ""
+    try:
+        head = f.read_text(encoding="utf-8", errors="ignore").splitlines()[0]
+    except OSError:
+        return ""
+    m = re.search(r"absolute offsets in ([^,;)]+)", head)
+    return m.group(1).strip() if m else ""
+
+
+def existing_pack_for(gguf: pathlib.Path, packs_root: pathlib.Path) -> pathlib.Path | None:
+    """Any pack under <packs_root> whose native_experts.txt names this GGUF."""
+    if not packs_root.is_dir():
+        return None
+    want = gguf.name.lower()
+    for d in sorted(packs_root.iterdir()):
+        if d.is_dir() and native_header_gguf(d).lower() == want:
+            return d
+    return None
+
+
+def main(argv: list[str]) -> int:
+    ap = argparse.ArgumentParser(description="Build the Strata pack for one GGUF (seconds, ~60 MB).")
+    ap.add_argument("--gguf", required=True, help="the model file (one shard is enough)")
+    ap.add_argument("--packs", default=None, help="where packs live (default ./packs)")
+    ap.add_argument("--family", default="qwen36", help="model family, decides the extra iq_pack flags (default qwen36)")
+    ap.add_argument("--out", default=None, help="explicit output dir (default <packs>/<family>-<quant>)")
+    ap.add_argument("--no-compat-bf16", action="store_true", help="do not pass --compat-bf16 (only if you know why)")
+    ap.add_argument("--force", action="store_true", help="rebuild even if a pack for this GGUF already exists")
+    ap.add_argument("--quiet", action="store_true")
+    a = ap.parse_args(argv)
+
+    gguf = pathlib.Path(a.gguf).expanduser().resolve()
+    if not gguf.is_file():
+        print(f"make-pack: not a file: {gguf}", file=sys.stderr)
+        return 2
+    if not IQ_PACK.is_file():
+        print(f"make-pack: {IQ_PACK} is missing (run this from the Strata checkout)", file=sys.stderr)
+        return 3
+
+    packs_root = pathlib.Path(a.packs).expanduser().resolve() if a.packs else pathlib.Path.cwd() / "packs"
+    if not a.force:
+        found = existing_pack_for(gguf, packs_root)
+        if found:
+            print(f"make-pack: {gguf.name} already has a pack: {found}")
+            print("make-pack: nothing to do (use --force to rebuild)")
+            return 0
+
+    out = pathlib.Path(a.out).expanduser().resolve() if a.out else packs_root / pack_tag(gguf, a.family)
+    out.mkdir(parents=True, exist_ok=True)
+
+    flags = [] if a.no_compat_bf16 else list(FAMILY_ARGS.get(a.family, []))
+    cmd = [sys.executable, str(IQ_PACK), "--gguf", str(gguf), "--out", str(out), *flags]
+    if not a.quiet:
+        print(f"make-pack: {gguf.name}")
+        print(f"make-pack: -> {out}")
+        print(f"make-pack: {' '.join(cmd[1:])}")
+    t0 = time.time()
+    env = dict(os.environ)
+    # let iq_pack import llama.cpp's gguf-py when the file needs dequantizing
+    for cand in (HERE.parent / "llama.cpp" / "gguf-py",):
+        if cand.is_dir() and "STRATA_GGUF_PY" not in env:
+            env["STRATA_GGUF_PY"] = str(cand)
+    rc = subprocess.call(cmd, env=env)
+    if rc != 0:
+        print(f"make-pack: iq_pack failed (exit {rc})", file=sys.stderr)
+        return 4
+
+    # the pack names the GGUF it was built from: make sure it is the one asked for
+    named = native_header_gguf(out)
+    if named and named.lower() != gguf.name.lower():
+        print(f"make-pack: the pack points at {named}, not {gguf.name}", file=sys.stderr)
+        return 5
+
+    want = ("dense.bin", "index.txt", "native_experts.txt")
+    missing = [f for f in want if not (out / f).exists()]
+    if missing:
+        print(f"make-pack: incomplete pack, missing: {', '.join(missing)}", file=sys.stderr)
+        return 4
+
+    mb = sum(p.stat().st_size for p in out.rglob("*") if p.is_file()) / 1e6
+    print(f"make-pack: done in {time.time() - t0:.1f}s, {mb:.0f} MB in {out}")
+    print(f"make-pack: the engine needs  --pack \"{out}\"  and  --native \"{gguf}\"")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
