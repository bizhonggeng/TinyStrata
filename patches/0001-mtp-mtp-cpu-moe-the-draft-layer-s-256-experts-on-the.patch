+// --mtp-cpu-moe: the draft layer's routed experts, all of them on the CPU (ggml-cpu's own dots - the same bits the
+// engine's CPU expert pool produces).  Every (token, slot) is computed from host RAM; the result goes to parts_ [T][K][N].
+void MtpDrafter::cpu_expert_rows(int T, int K, int64_t N) {
+    if (!cpu_fmt_ok_ || cpu_experts_ == nullptr || mixed_ == nullptr || parts_ == nullptr) return;
+    const strata::kernels::cpu::NativeFmt& f = cpu_fmt_;
+    const int64_t ne = f.n_embd, nff = f.n_ff;
+    std::vector<float> hx((size_t) T * N);          // the token activations (mixed_ is device memory)
+    std::vector<int32_t> hid((size_t) T * K);       // the routed ids
+    if (cudaMemcpy(hx.data(), mixed_, (size_t) T * N * sizeof(float), cudaMemcpyDeviceToHost) != cudaSuccess) return;
+    if (cudaMemcpy(hid.data(), ids_, (size_t) T * K * sizeof(int32_t), cudaMemcpyDeviceToHost) != cudaSuccess) return;
+    std::vector<float> hp((size_t) T * K * N);      // parts_, filled here
+    std::vector<uint8_t> actq(f.act_bytes), hq(f.h_bytes);
+    std::vector<float> ff((size_t) nff), acc((size_t) ne);
+    for (int t = 0; t < T; ++t) {
+        strata::kernels::cpu::native_quant_act(f, hx.data() + (size_t) t * N, actq.data());
+        const void* ap = (const void*) actq.data();
+        for (int k = 0; k < K; ++k) {
+            const int32_t e = hid[(size_t) (t * K + k)];
+            if (e < 0 || e >= n_experts_) continue;         // out of range: zeros (never happens)
+            const uint8_t* blob = cpu_experts_ + (size_t) e * f.bytes;
+            float* ffp = ff.data();
+            strata::kernels::cpu::native_gu_rows(f, blob, &ap, 1, &ffp, 0, nff);
+            strata::kernels::cpu::native_quant_h(f, ff.data(), hq.data());
+            const void* hqp = (const void*) hq.data();
+            float* outp = acc.data();
+            strata::kernels::cpu::native_down_rows(f, blob, &hqp, 1, &outp, 0, ne);
+            std::memcpy(hp.data() + ((size_t) (t * K + k)) * N, acc.data(), (size_t) N * sizeof(float));
+        }
+    }
+    cudaMemcpyAsync(parts_, hp.data(), (size_t) T * K * N * sizeof(float), cudaMemcpyHostToDevice, cs_);
+}
