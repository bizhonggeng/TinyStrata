+class _Stamped:
+    """一条 stdout/stderr 包装：每行前面加 HH:MM:SS（本地时间）。
+
+    只缓冲“还没遇到换行”的尾巴，遇到换行就整行写出并 flush，所以 `print(..., flush=True)`
+    与子进程/线程交错写都不会把半行戳上时间戳。`log_timestamps: false` 时不安装。"""
+
+    def __init__(self, stream):
+        self._s = stream
+        self._buf = ""
+        self._lock = threading.Lock()
+
+    def write(self, data):
+        if not data:
+            return 0
+        with self._lock:
+            self._buf += data
+            while "\n" in self._buf:
+                line, self._buf = self._buf.split("\n", 1)
+                self._s.write(time.strftime("%H:%M:%S ") + line + "\n")
+            self._s.flush()
+        return len(data)
+
+    def flush(self):
+        with self._lock:
+            if self._buf:
+                self._s.write(time.strftime("%H:%M:%S ") + self._buf)
+                self._buf = ""
+            self._s.flush()
+
+    def __getattr__(self, name):
+        return getattr(self._s, name)
+
+
+def install_log_timestamps():
+    """把所有 print() 输出（stdout/stderr）逐行加上 HH:MM:SS。幂等。"""
+    for name in ("stdout", "stderr"):
+        cur = getattr(sys, name)
+        if not isinstance(cur, _Stamped):
+            setattr(sys, name, _Stamped(cur))
+
