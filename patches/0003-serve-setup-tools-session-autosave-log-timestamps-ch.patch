+
+    missing = [k for k in QWEN35MOE_REQUIRED if num(k) is None]
+    if missing:
+        return "no", f"it has no qwen35moe.{missing[0]}: the engine needs that key"
+    layers = num("block_count") - (num("nextn_predict_layers", 0) or 0)
+    mtp = num("nextn_predict_layers", 0) or 0
+    bad = []
+    for k, want in (("attention.key_length", 256), ("attention.value_length", 256),
+                    ("rope.dimension_count", 64), ("ssm.state_size", 128), ("ssm.conv_kernel", 4),
+                    ("full_attention_interval", 4), ("attention.head_count_kv", 2)):
+        if num(k) != want:
+            bad.append(f"{k}={num(k)} (needs {want})")
+    if not (0 < layers <= QWEN35MOE_CAPS["layers"] and layers % 4 == 0):
+        bad.append(f"block_count-nextn={layers} (a multiple of 4, at most 48)")
+    if not 0 <= mtp <= QWEN35MOE_CAPS["mtp"]:
+        bad.append(f"nextn_predict_layers={mtp} (0 or 1)")
+    if not (0 < num("embedding_length") <= QWEN35MOE_CAPS["embd"] and num("embedding_length") % 256 == 0):
+        bad.append(f"embedding_length={num('embedding_length')} (a multiple of 256, at most 2560)")
+    if not 0 < num("attention.head_count") <= QWEN35MOE_CAPS["head"]:
+        bad.append(f"attention.head_count={num('attention.head_count')} (at most 24)")
+    if not 0 < num("ssm.group_count") <= QWEN35MOE_CAPS["ssm_k"]:
+        bad.append(f"ssm.group_count={num('ssm.group_count')} (at most 16)")
+    if not 0 < num("ssm.time_step_rank") <= QWEN35MOE_CAPS["ssm_v"]:
+        bad.append(f"ssm.time_step_rank={num('ssm.time_step_rank')} (at most 48)")
+    if num("ssm.inner_size") != num("ssm.state_size") * num("ssm.time_step_rank"):
