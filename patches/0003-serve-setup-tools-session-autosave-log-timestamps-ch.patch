+def qwen35moe_geometry(meta: dict) -> tuple[str, str]:
+    """Mirror of the engine's qwen35moe checks (src/core/layout.cpp: geometry_from_gguf).
+
+    A header reading: this says whether the engine gets past its geometry door, not how well the model answers.
+    """
+    def num(name, default=None):
