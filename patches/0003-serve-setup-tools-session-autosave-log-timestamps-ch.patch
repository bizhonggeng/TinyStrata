+"""Session autosave (#local): a disk fallback for the conversation cache's parked sessions.
+
+The engine parks whole conversations in host RAM (`--conversation-cache-mib`); a client that
+switches between several long conversations gets each one back through the front - a 52K-token
+conversation returns in under a second instead of minutes of re-reading.  When the RAM floor
+(`--conversation-cache-min-free-mib`) or the cache budget does not fit the snapshot, the engine
+skips parking ("conversation cache: skip parking ...") and the switch back re-reads everything.
+
+This module closes that gap on the server side, without touching the engine or the clients:
+
+  * after a request whose prompt was long enough, SAVE the engine's live conversation to
+    `slot_save_path/autosave/<fingerprint>.sess` (throttled: only when it grew by a step);
+  * before running a request whose fingerprint differs from the last active one, RESTORE the
+    saved file when there is one.  The engine then matches its token prefix and reuses the
+    whole KV - exactly the parking path, from the disk.
+
+The fingerprint is sha256 over the first message's role and text content, so it is stable
+across the turns of one conversation and changes when the conversation is compacted (a
+compacted conversation is a new chain; re-reading its short summary is the same the parking
+path does).  Files carry an `autosave-` prefix and are pruned LRU-style; names a client saves
+itself through POST /slots/0 are never touched.
+
+Every step is best effort: a restore of a stale file only costs its read time (the engine
+falls back to reading the prompt), a failed save costs a log line.  Nothing here can change a
+reply's content.  The whole feature is off unless the server runs with `--slot-save-path` and
+STRATA_AUTOSAVE_MIN_TOKENS > 0."""
+
+import hashlib
+import os
+import threading
+import time
+
+AUTOSAVE_DIR = "autosave"
+PREFIX = "autosave-"
+SUFFIX = ".sess"
+
+AUTOSAVE_DIR = "autosave"
+PREFIX = "autosave-"
+SUFFIX = ".sess"
+
+
+class AutoSave:
+    """The autosave index and the save/restore decisions.  One instance per Service; all
+    calls happen on the request path, which the server serializes (the engine is FIFO), so a
+    simple lock around the index is enough."""
+
+    def __init__(self, slot_save_path: str | None):
+        self.dir = os.path.join(slot_save_path, AUTOSAVE_DIR) if slot_save_path else None
+        self.min_tokens = _env_int("STRATA_AUTOSAVE_MIN_TOKENS", 4096)
+        self.step_tokens = _env_int("STRATA_AUTOSAVE_STEP_TOKENS", 2048)
+        self.keep = _env_int("STRATA_AUTOSAVE_KEEP", 8)
+        self.lock = threading.Lock()
+        self.active_fp: str | None = None          # the fingerprint of the session the engine holds now
+        self.active_tokens = 0                      # its prompt size at the last save
+        self.index: dict[str, dict] = {}            # fp -> {"file": name, "tokens": N, "at": ts}
+        if self.dir and self.min_tokens > 0:
+            try:
+                os.makedirs(self.dir, exist_ok=True)
+            except OSError as e:
+                print(f"[strata] autosave off: cannot create {self.dir}: {e}", flush=True)
+                self.dir = None
+
+    @property
+    def enabled(self) -> bool:
+        return bool(self.dir) and self.min_tokens > 0
+
+    def on(self) -> str:
+        """A one-line description for the startup log."""
+        if not self.enabled:
+            return "session autosave off" + ("" if self.dir else " (needs --slot-save-path)") \
+                if self.min_tokens > 0 else "session autosave off (STRATA_AUTOSAVE_MIN_TOKENS=0)"
+        return (f"session autosave on: {self.dir} (min {self.min_tokens} tokens, step "
+                f"{self.step_tokens}, keep {self.keep})")
+
+    # ---- decisions -------------------------------------------------------
+
+    def restore_wanted(self, fp: str | None) -> bool:
+        """True when the incoming request's session differs from the one the engine holds and
+        there is a saved file for it."""
+        if not self.enabled or fp is None or fp == self.active_fp:
+            return False
+        return fp in self.index
+
+    def save_wanted(self, fp: str | None, prompt_tokens: int) -> bool:
+        """True when the finished request's conversation is long enough and grew by a step
+        since the last save of this session."""
+        if not self.enabled or fp is None or prompt_tokens < self.min_tokens:
+            return False
+        if fp == self.active_fp and prompt_tokens - self.active_tokens < self.step_tokens:
+            return False                            # nothing worth writing since the last save
+        if fp != self.active_fp:
+            prev = self.index.get(fp)
+            if prev and prompt_tokens - prev["tokens"] < self.step_tokens:
+                return False                        # the file on disk is recent enough
+        return True
+
+    # ---- actions ---------------------------------------------------------
+
+    def restore(self, svc, fp: str) -> None:
+        """RESTORE the session file for `fp` (the caller holds the request's serialization:
+        engine work is FIFO).  Best effort: any failure only logs."""
+        entry = self.index.get(fp)
+        if not entry:
+            return
+        try:
+            r = svc.engine.session_file("restore", os.path.join(self.dir, entry["file"]))
+            self.active_fp, self.active_tokens = fp, entry["tokens"]
+            print(f"[strata] autosave: restored {r.get('tokens', entry['tokens'])} tokens from {entry['file']} "
+                  f"({r.get('ms', 0):.0f} ms)", flush=True)
+        except Exception as e:                      # noqa: BLE001 - a miss must not fail the request
+            print(f"[strata] autosave: restore failed ({e}); the engine reads the prompt", flush=True)
+            self.index.pop(fp, None)                # the file is no use to anyone
+            self.active_fp = None
+
+    def save(self, svc, fp: str, prompt_tokens: int) -> None:
+        """SAVE the engine's live conversation for `fp`.  Best effort, and throttled by
+        save_wanted(); the caller runs this after the reply, still between requests."""
+        name = f"{PREFIX}{fp}{SUFFIX}"
+        try:
+            r = svc.engine.session_file("save", os.path.join(self.dir, name))
+            self.index[fp] = {"file": name, "tokens": prompt_tokens, "at": time.time()}
+            self.active_fp, self.active_tokens = fp, prompt_tokens
+            self._prune()
+            ms = r.get("ms", 0)
+            mb = r.get("bytes", 0) / 1048576
+            print(f"[strata] autosave: saved {prompt_tokens} tokens ({mb:.0f} MiB, {ms:.0f} ms) "
+                  f"to {name}; sessions on disk: {len(self.index)}", flush=True)
+        except Exception as e:                      # noqa: BLE001
+            print(f"[strata] autosave: save failed ({e})", flush=True)
+
+    def note_active(self, fp: str | None, prompt_tokens: int = 0) -> None:
+        """Record which session the engine now holds, without saving (a restore by a client,
+        a short conversation, anything that changes the live session behind our back)."""
+        with self.lock:
+            if fp != self.active_fp:
+                self.active_fp, self.active_tokens = fp, prompt_tokens
+
+    def forget(self) -> None:
+        """The engine ended (a restart empties its RAM and its live session): nothing is
+        active any more.  The index survives - the files are still good for a restore."""
+        self.active_fp = None
+
+    def _prune(self) -> None:
+        """Keep at most `keep` autosave files (never the active one), oldest first."""
+        if len(self.index) <= self.keep:
+            return
+        for fp, entry in sorted(self.index.items(), key=lambda kv: kv[1]["at"]):
+            if len(self.index) <= self.keep:
+                break
+            if fp == self.active_fp:
+                continue
+            try:
+                os.remove(os.path.join(self.dir, entry["file"]))
+            except OSError:
+                pass
+            self.index.pop(fp, None)
+
+
+def fingerprint(messages) -> str | None:
+    """sha256 over the first message's role and text content: stable across the turns of one
+    conversation, changes on compaction (a compacted conversation is a new chain - the same
+    re-reading the parking path does).  None when there is nothing to key on (no messages, no
+    text part)."""
+    for m in messages or []:
+        if not isinstance(m, dict):
+            continue
+        content = m.get("content")
+        if isinstance(content, str) and content:
+            h = hashlib.sha256()
+            h.update(m.get("role", "").encode("utf-8", "replace"))
+            h.update(b"\x00")
+            h.update(content.encode("utf-8", "replace"))
+            return h.hexdigest()[:16]
+    return None
+
+
+def _env_int(name: str, default: int) -> int:
+    try:
+        return max(0, int(os.environ.get(name, "") or default))
+    except ValueError:
+        return default
