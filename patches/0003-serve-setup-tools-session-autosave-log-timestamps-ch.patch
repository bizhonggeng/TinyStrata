+    def _log_pump(self, proc, log):
+        """把引擎的 stderr 逐行搬到日志文件，每行加 HH:MM:SS（LOG_TIMESTAMPS 打开时）。
+
+        必须一直读到 EOF：管道满了而不排空，引擎会阻塞在写 stderr 上。"""
+        lock = getattr(log, "_strata_lock", None)
+        if lock is None:
+            lock = threading.Lock()
+            try:
+                log._strata_lock = lock
+            except AttributeError:
+                pass
+        try:
+            for line in proc.stderr:
+                stamp = time.strftime("%H:%M:%S ")
+                with lock:
+                    try:
+                        log.write(stamp + line)
+                        log.flush()
+                    except (OSError, ValueError):
+                        return
+        except (OSError, ValueError):
+            return
